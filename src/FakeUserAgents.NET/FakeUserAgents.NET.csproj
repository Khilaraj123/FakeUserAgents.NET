<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet metadata -->
		<PackageId>Dotnet.FakeUserAgents</PackageId>
		<Version>1.0.1</Version>
		<Authors>Khilaraj Regmi</Authors>
		<Company>Khilaraj Regmi</Company>

		<Title>Dotnet.FakeUserAgents</Title>
		<Description>
			High-performance .NET library for generating and rotating realistic
			browser User-Agent profiles for web scrapers, crawlers, API clients,
			and integration tests.
		</Description>

		<PackageTags>user-agent;useragent;fake-user-agent;scraping;web-scraping;crawler;httpclient;browser;bot</PackageTags>

		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<RepositoryUrl>https://github.com/Khilaraj123/Dotnet.FakeUserAgents</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageProjectUrl>https://github.com/Khilaraj123/Dotnet.FakeUserAgents</PackageProjectUrl>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

		<PackageReleaseNotes>Release 1.0.1: Included LICENSE and README package assets, added symbols (.snupkg), implemented IReadOnlyList on IndexedPool, and resolved doc warnings.</PackageReleaseNotes>

		<PackageOutputPath>./nupkg</PackageOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\useragents.json" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Dotnet.FakeUserAgents.Tests" />
	</ItemGroup>

</Project>
